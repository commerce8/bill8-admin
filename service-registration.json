          "token_endpoint_auth_method": "none",
          "scopes": [
            "openid",
            "profile",
            "email",
            "offline_access",
            "bill8:merchants:accounts:read",
            "bill8:merchants:accounts:write",
            "bill8:merchants:persons:read",
            "bill8:payments:charges:read",
            "bill8:payments:refunds:read",
            "bill8:payments:disputes:read",
            "bill8:risk:rules:read",
            "bill8:risk:rules:write",
            "bill8:risk:screenings:read",
            "bill8:risk:reviews:read",
            "bill8:risk:reviews:write",
            "bill8:ledger:balances:read",
            "bill8:ledger:fees:read",
            "bill8:ledger:fees:write",
            "bill8:reporting:types:read",
            "bill8:reporting:types:write",
            "bill8:reporting:runs:read",
            "storage:env:read",
            "storage:env:write"
          ],
          "consent_required": false
